# Cute shell shortcuts
alias ll="ls -l"

# Cool colors for man pages
alias man="TERMINFO=~/.terminfo TERM=mostlike LESS=C PAGER=less man"

# Enable color support of ls, handling both GNU (Linux) and BSD (macOS) tools
if command -v dircolors >/dev/null 2>&1; then
    # GNU coreutils (Linux)
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'
else
    # BSD tools (macOS)
    export CLICOLOR=1
    alias ls='ls -G'
fi

# grep colors work on both GNU and BSD grep
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Give me a nice, distinguishable make output
alias make='clear && make'
alias m='make'

# Some more, to avoid mistakes
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
