# Using Homebrew binaries first.
# Detect the prefix by which brew actually exists, so it works on both
# Apple Silicon (/opt/homebrew) and Intel (/usr/local), and stays correct
# even when the shell runs under Rosetta.
for BREW_PREFIX in /opt/homebrew /usr/local; do
  [ -x "$BREW_PREFIX/bin/brew" ] && break
done
export PATH=$BREW_PREFIX/bin:$BREW_PREFIX/sbin:$PATH

type jenv >/dev/null
if [ $? -eq 0 ] ; then
  eval "$(jenv init -)"
fi
type scalaenv >/dev/null
if [ $? -eq 0 ] ; then
  eval "$(scalaenv init -)"
fi
type sbtenv >/dev/null
if [ $? -eq 0 ] ; then
  eval "$(sbtenv init -)"
fi
type pyenv >/dev/null
if [ $? -eq 0 ] ; then
  eval "$(pyenv init -)"
fi

#export JAVA_HOME=`/usr/libexec/java_home`
export JENV_HOME=$HOME/.jenv
export SCALAENV_HOME=$HOME/.scalaenv
export SBTENV=$HOME/.sbtenv
export SPARK_PATH=$HOME/Documents/tools/spark-2.4.3-bin-hadoop2.7

export PATH=$PATH:$JAVA_HOME:$SPARK_PATH/bin:$HOME/.local/bin
