
type jenv >/dev/null
if [ $? -eq 0 ] ; then
  eval "$(jenv init -)"
fi
type scalaenv >/dev/null
if [ $? -eq 0 ] ; then
  eval "$(scalaenv init -)"
fi
type sbtenv >/dev/null
if [ $? -eq 0 ] ; then
  eval "$(sbtenv init -)"
fi

export JAVA_HOME=`/usr/libexec/java_home`
export JENV_HOME=$HOME/.jenv
export SCALAENV_HOME=$HOME/.scalaenv
export SBTENV=$HOME/.sbtenv
export SPARK_PATH=$HOME/Documents/tools/spark-2.4.3-bin-hadoop2.7

# Using local binary first for Homebrew
export PATH=/usr/local/bin:/usr/local/sbin:$PATH
export PATH=$PATH:$JAVA_HOME:$JENV_HOME/bin:$SCALAENV_HOME/bin:$SBTENV/bin:$SPARK_PATH/bin
#export DYLD_LIBRARY_PATH=/usr/local/Cellar/openssl/1.0.2q/lib

# Setting up for pyenv
export PATH="$HOME/.pyenv/shims:$PATH"
eval "$(pyenv init -)"
#eval "$(pyenv virtualenv-init -)"
