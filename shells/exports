# User info — shared by both ~/.bashrc and ~/.zshrc.
export USERNAME="Chih-Feng Lin"
export NICKNAME="Chih-Feng"

# Using Homebrew binaries first.
# Detect the prefix by which brew actually exists, so it works on both
# Apple Silicon (/opt/homebrew) and Intel (/usr/local), and stays correct
# even when the shell runs under Rosetta.
for BREW_PREFIX in /opt/homebrew /usr/local; do
  [ -x "$BREW_PREFIX/bin/brew" ] && break
done
export PATH=$BREW_PREFIX/bin:$BREW_PREFIX/sbin:$PATH

# Version managers — load each only if it's installed.
# (command -v avoids the stderr leak of `type` and the redundant $? check.)
for _vm in jenv scalaenv sbtenv pyenv; do
  command -v "$_vm" >/dev/null 2>&1 && eval "$("$_vm" init -)"
done
unset _vm

#export JAVA_HOME=`/usr/libexec/java_home`
export JENV_HOME=$HOME/.jenv
export SCALAENV_HOME=$HOME/.scalaenv
export SBTENV=$HOME/.sbtenv
export SPARK_PATH=$HOME/Documents/tools/spark-2.4.3-bin-hadoop2.7

# Append optional dirs to PATH — but only when the var is set AND the dir
# exists. An empty element (e.g. unset $JAVA_HOME) would expand to "::",
# which Unix treats as the current directory: a PATH security hazard.
for _dir in "$JAVA_HOME" "$SPARK_PATH/bin" "$HOME/.local/bin"; do
  [ -n "$_dir" ] && [ -d "$_dir" ] && PATH="$PATH:$_dir"
done
unset _dir
export PATH
